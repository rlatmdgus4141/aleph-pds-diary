  "ownership": "plans.owner_id; dependent records scoped via joins; auth_users.id from server session only",
  "session": "SHA-256 of random 32-byte opaque cookie, 12h absolute expiry; password change revokes all; logout revokes current",
  "timezone": "Asia/Seoul",
  "unit": "minutes",
  "observations": "immutable baseline and closed-day evidence; exactly 5 distinct dates; rule change after day2 before day3; null missing excluded from averages; mean rounded to 1 decimal; week Monday",
  "observation_cancellation": "Before actual work only; unfinished same-day observation; no execution created after start; explicit reason and user confirmation; original JSON preserved and exported; finished rows cannot be cancelled",
  "observation_order_exclusion": "Unfinished same-day observation only; server verifies at least one target execution began before baseline was fixed. Preserve original observation, matching execution snapshots and reason in observation_cancellations.original_json with exclusion_kind=start_order. Do not modify actual logs or completion state. Exclude only this invalid observation from the five-day sequence; next observation gets a new timestamp and must select work not yet performed that day."
